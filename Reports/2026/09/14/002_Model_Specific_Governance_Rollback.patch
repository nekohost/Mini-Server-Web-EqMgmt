+// manifest 순서로 노드 ID를 정렬한다.
+function manifestOrder(nodeIds, manifest) {
+  // 비교용 ID 집합을 만든다.
+  const selected = new Set(nodeIds);
+  // manifest 노드 키 순서에서 선택된 ID만 남긴다.
+  return Object.keys(manifest.nodes ?? {}).filter((nodeId) => selected.has(nodeId));
