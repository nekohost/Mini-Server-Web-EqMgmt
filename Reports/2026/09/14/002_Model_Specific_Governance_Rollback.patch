+      // 새 pack을 현재 노드부터 시작한다.
+      currentOptional = [nodeId];
+    } else {
+      // 예산 내이면 후보를 현재 pack으로 채택한다.
+      currentOptional = proposed;
+    }
+  }
+  // 남은 선택 노드 또는 base 전용 pack을 결과에 추가한다.
