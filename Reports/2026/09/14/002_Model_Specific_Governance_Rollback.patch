+    const proposed = [...currentOptional, nodeId];
+    // 후보 pack의 토큰을 계산한다.
+    const proposedPack = createPack(proposed);
+    // 이미 선택 노드가 있고 후보가 예산을 넘으면 현재 pack을 확정한다.
