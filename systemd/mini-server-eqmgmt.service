[Unit]
Description=Mini-Server Equipment Management Web Service (Gunicorn)
After=network.target

[Service]
Type=simple
User=nekohost
Group=nekohost
# 운영 기준 경로: 2026-09-07 실제 Gunicorn 구동 경로로 확인했습니다.
WorkingDirectory=/home/nekohost/services/Mini-Server-Web-EqMgmt
Environment=PYTHONUNBUFFERED=1
# 기동 전 경로·가상환경을 명시적으로 검사해 경로 변경을 즉시 드러냅니다.
ExecStartPre=/usr/bin/test -f /home/nekohost/services/Mini-Server-Web-EqMgmt/app.py
ExecStartPre=/usr/bin/test -x /home/nekohost/services/Mini-Server-Web-EqMgmt/.venv/bin/gunicorn
ExecStart=/home/nekohost/services/Mini-Server-Web-EqMgmt/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:5000 --access-logfile - --error-logfile - --capture-output app:app
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
