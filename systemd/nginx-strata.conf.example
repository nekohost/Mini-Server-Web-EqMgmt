# Retirement deny snippet for this equipment-management HTTPS server only.
# Replace the previously reviewed eqmgmt-strata.conf contents after configuration backup.
# Keep the existing include until its deny replacement is verified with nginx -t and reload.
# No proxy_pass/auth_request/key include remains. Other sites and shared Strata are independent.
# Existing private key files must be retained under their separate approved lifecycle.

location = /strata { return 410; }
location ^~ /strata/ { return 410; }
location = /api/strata { return 410; }
location ^~ /api/strata/ { return 410; }
location = /_eqmgmt_strata_auth { return 410; }
location = /static/vendor/strata { return 410; }
location ^~ /static/vendor/strata/ { return 410; }
location = /static/js/strata_page.js { return 410; }
location = /static/js/strata_bridge.js { return 410; }
location = /static/css/strata.css { return 410; }
# /ai and /ai/console continue through Flask and show authenticated retirement notices.
